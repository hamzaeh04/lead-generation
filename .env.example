# ============================================================
# Lead Intelligence Platform — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- App ----
ENVIRONMENT=development
DEBUG=true

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Database ----
POSTGRES_USER=postgresql
POSTGRES_PASSWORD=postgresql
POSTGRES_DB=lead_platform
# Used directly by the backend when running outside docker-compose:
DATABASE_URL=postgresql+asyncpg://postgresql:postgresql@localhost:5432/lead_platform

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================================
# Provider credentials (added in later phases; do not hard-code
# these anywhere in source — they are read from the environment
# only, by provider classes under app/providers/*).
# ============================================================

# Lead / company / person discovery
APOLLO_API_KEY=
PDL_API_KEY=
SERPAPI_API_KEY=
APIFY_API_TOKEN=
PHANTOMBUSTER_API_KEY=

# Email discovery / verification
HUNTER_API_KEY=

# AI personalization
OPENAI_API_KEY=

# Email sending (SMTP fallback provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Email sending (future providers — leave blank until configured)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
POSTMARK_API_KEY=
