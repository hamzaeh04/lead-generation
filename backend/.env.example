# ============================================================
# Lead Intelligence Platform — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ---- App ----
ENVIRONMENT=development
DEBUG=true

# ---- Security ----
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Database ----
POSTGRES_USER=lead_platform
POSTGRES_PASSWORD=lead_platform
POSTGRES_DB=lead_platform
DATABASE_URL=postgresql+asyncpg://lead_platform:lead_platform@localhost:5432/lead_platform

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000

# Public backend URL for open-tracking pixels (Delivery double-tick) and Apollo webhooks.
# Example: https://your-api.vercel.app  or an ngrok URL for local.
PUBLIC_BASE_URL=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================================
# Provider credentials — left blank. Any provider with no key here is
# simply unavailable (never fabricated data); fill in only the ones you
# actually have accounts for.
# ============================================================

# Lead / company / person discovery
APOLLO_API_KEY=
SMARTLEAD_API_KEY=
PHANTOMBUSTER_API_KEY=

# AI personalization
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email sending (SMTP fallback provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Email sending (future providers — leave blank until configured)
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
POSTMARK_API_KEY=
